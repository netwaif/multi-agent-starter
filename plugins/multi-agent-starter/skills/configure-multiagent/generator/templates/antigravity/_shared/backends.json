{
  "schema_version": "1",
  "flavor": "antigravity",
  "multiagent_root_env": "MULTIAGENT_ROOT",
  "_note": "오케스트레이터 = Antigravity(agy/IDE, Gemini 3.1 Pro High). gemini 워커 없음 — 멀티모달/롱독은 오케스트레이터가 직접 수행(같은 벤더 worker는 독립성 무의미).",
  "workers": {
    "claude-main": {
      "model": "host-default",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "claude",
        "args_template": ["--prompt", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "repo_root",
      "write_policy": "none",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 600
    },
    "codex-main": {
      "model": "codex-default",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "codex",
        "args_template": ["exec", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "repo_root",
      "write_policy": "none",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 600
    },
    "codex-critic": {
      "model": "codex-default",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "codex",
        "args_template": ["exec", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "repo_root",
      "write_policy": "none",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 600
    },
    "grok-critic": {
      "model": "grok-4.5",
      "call_type": "cli",
      "brief_mode": "file-arg",
      "cli": {
        "command": "grok",
        "args_template": ["--prompt-file", "@brief", "--max-turns", "1", "--output-format", "plain", "-m", "grok-4.5"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "isolated_tmp",
      "write_policy": "none",
      "capabilities": { "input_mode": "inline_only", "file_read": false, "tool_use": false },
      "result_contract": { "mode": "text", "output_required": true, "min_non_whitespace_chars": 1 },
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300
    },
    "grok-intel": {
      "model": "grok-4.5",
      "call_type": "cli",
      "brief_mode": "file-arg",
      "role": "realtime-intel",
      "cli": {
        "command": "grok",
        "args_template": ["--prompt-file", "@brief", "--max-turns", "6", "--output-format", "plain", "-m", "grok-4.5", "--tools", "web_search,x_search", "--permission-mode", "dontAsk"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "isolated_tmp",
      "write_policy": "none",
      "capabilities": { "input_mode": "inline_only", "file_read": false, "tool_use": true, "live_data": true, "tools_allowed": ["web_search", "x_search"] },
      "effect_class": "idempotent_remote",
      "determinism": "live_nondeterministic",
      "result_contract": { "mode": "text", "output_required": true, "min_non_whitespace_chars": 1, "evidence_required": true },
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 600
    }
  }
}
