{
  "schema_version": "1",
  "flavor": "grok",
  "multiagent_root_env": "MULTIAGENT_ROOT",
  "_note": "오케스트레이터 = grok CLI(grok-4.5, 네이티브 web_search+x_search). grok-critic/grok-intel 워커 없음 — 실시간 web/X-SNS 인텔은 오케스트레이터가 직접 수행(같은 벤더 worker는 독립성 무의미).",
  "workers": {
    "claude-main": {
      "model": "host-default",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "claude",
        "args_template": ["--prompt", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "repo_root",
      "write_policy": "none",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 600
    },
    "codex-main": {
      "model": "codex-default",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "codex",
        "args_template": ["exec", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "repo_root",
      "write_policy": "none",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 600
    },
    "codex-critic": {
      "model": "codex-default",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "codex",
        "args_template": ["exec", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "repo_root",
      "write_policy": "none",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 600
    },
    "gemini": {
      "model": "gemini-3.1-pro-high",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "agy",
        "args_template": ["--prompt", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "isolated_tmp",
      "write_policy": "none",
      "capabilities": { "input_mode": "inline_only", "file_read": false, "tool_use": false },
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300,
      "fallbacks": [
        {
          "model": "gemini-3.1-pro-high", "call_type": "api", "timeout": 300,
          "approval_class": "worker", "result_capture": "envelope",
          "api": { "ref": "adapters/gemini_api.sh", "required_env": ["GEMINI_API_KEY"],
                   "brief_pass": "arg1", "retry": { "max": 2, "backoff_s": 2 } }
        }
      ]
    }
  }
}
