{
  "schema_version": "1",
  "flavor": "codex",
  "multiagent_root_env": "MULTIAGENT_ROOT",
  "workers": {
    "codex-main": {
      "model": "codex-default",
      "call_type": "native",
      "native": {
        "subagent_type": "codex-main",
        "prompt_source": "brief",
        "model_alias": "codex-default"
      },
      "approval_class": "worker",
      "result_capture": "orchestrator"
    },
    "claude-critic": {
      "model": "host-default",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "claude",
        "args_template": [
          "--disable-slash-commands",
          "--tools",
          "Read,Glob,Grep",
          "--add-dir",
          "@target_repo",
          "--print",
          "@brief_content"
        ]
      },
      "cwd_policy": "isolated_tmp",
      "approval_class": "worker",
      "result_capture": "envelope",
      "tool_policy": "read-only: isolated cwd; target exposed only through --add-dir; Read,Glob,Grep; slash commands disabled",
      "timeout": 300
    },
    "gemini": {
      "model": "gemini-3.1-pro-high",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "agy",
        "args_template": [
          "--model",
          "gemini-3.1-pro-high",
          "--prompt",
          "@brief_content"
        ]
      },
      "cwd_policy": "isolated_tmp",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300,
      "fallbacks": [],
      "fallback_note": "api 폴백 슬롯(adapters/gemini_api.sh)은 미구현(무조건 exit 4)이라 비활성 — 등록 시 거짓 안전신호. REST 구현 후 재등록."
    }
  }
}
