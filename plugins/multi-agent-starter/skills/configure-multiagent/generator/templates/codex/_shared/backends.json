{
  "schema_version": "1",
  "flavor": "codex",
  "multiagent_root_env": "MULTIAGENT_ROOT",
  "workers": {
    "codex-main": {
      "model": "codex-default",
      "call_type": "native",
      "native": { "subagent_type": "codex-main", "prompt_source": "brief", "model_alias": "codex-default" },
      "approval_class": "worker",
      "result_capture": "orchestrator"
    },
    "claude-critic": {
      "model": "host-default",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "claude",
        "args_template": ["--prompt", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "isolated_tmp",
      "write_policy": "none",
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300
    },
    "gemini": {
      "model": "gemini-3.1-pro-high",
      "call_type": "cli",
      "brief_mode": "content",
      "cli": {
        "command": "agy",
        "args_template": ["--prompt", "@brief_content"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "isolated_tmp",
      "write_policy": "none",
      "capabilities": { "input_mode": "inline_only", "file_read": false, "tool_use": false },
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300,
      "fallbacks": [
        {
          "model": "gemini-3.1-pro-high", "call_type": "api", "timeout": 300,
          "approval_class": "worker", "result_capture": "envelope",
          "api": { "ref": "adapters/gemini_api.sh", "required_env": ["GEMINI_API_KEY"],
                   "brief_pass": "arg1", "retry": { "max": 2, "backoff_s": 2 } }
        }
      ]
    },
    "grok-critic": {
      "status": "registered_disabled",
      "model": "grok-4.5",
      "call_type": "cli",
      "brief_mode": "file-arg",
      "cli": {
        "command": "grok",
        "args_template": ["--prompt-file", "@brief_file", "--max-turns", "1", "--output-format", "plain"],
        "non_interactive": { "stdin": "/dev/null", "no_tty": true, "on_permission_prompt": "fail" }
      },
      "cwd_policy": "isolated_tmp",
      "write_policy": "none",
      "capabilities": { "input_mode": "inline_only", "file_read": false, "tool_use": false },
      "result_contract": { "mode": "text", "output_required": true, "min_non_whitespace_chars": 1 },
      "approval_class": "worker",
      "result_capture": "envelope",
      "timeout": 300
    }
  }
}
